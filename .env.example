# ------------------------------------------------------------------
# Dalas – environment variables
# Kopieer naar .env.local (lokaal) en stel dezelfde variabelen in op Vercel.
# Alles is optioneel, behalve NEXT_PUBLIC_SITE_URL (canonical/sitemap)
# en de e-mailinstellingen (anders werken de formulieren niet in productie).
# ------------------------------------------------------------------

# Publieke URL van de website (zonder slash aan het einde)
NEXT_PUBLIC_SITE_URL=https://www.dalas.nl

# --- Contact (header, footer, contactpagina + LocalBusiness schema) ---
NEXT_PUBLIC_PHONE=
# WhatsApp-nummer internationaal, alleen cijfers, bv. 31612345678
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=

# --- Locatie (Local SEO). Laat leeg zolang de gegevens niet bekend zijn. ---
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_COUNTRY=NL
NEXT_PUBLIC_MAPS_URL=
# Formaat: "ma-vr 10:00-18:00; za 10:00-17:00"
NEXT_PUBLIC_OPENING_HOURS=

# --- Social / Google Business Profile ---
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# --- Analytics & Ads (gebruik óf GTM óf GA4 direct; GTM heeft de voorkeur) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels uit Google Ads (alleen nodig zonder GTM)
NEXT_PUBLIC_ADS_CONVERSION_APPOINTMENT=
NEXT_PUBLIC_ADS_CONVERSION_PRICE_REQUEST=
NEXT_PUBLIC_ADS_CONVERSION_CONTACT=

# --- Formulieren (server-side, nooit NEXT_PUBLIC_) ---
RESEND_API_KEY=
FORM_TO_EMAIL=
# Afzender moet een geverifieerd domein in Resend zijn
FORM_FROM_EMAIL="Dalas Website <website@dalas.nl>"
