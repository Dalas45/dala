# ------------------------------------------------------------------
# Dalas – environment variables
# Kopieer naar .env.local (lokaal) en stel dezelfde variabelen in op Vercel.
# Alles is optioneel, behalve NEXT_PUBLIC_SITE_URL (canonical/sitemap)
# en de e-mailinstellingen (anders werken de formulieren niet in productie).
# ------------------------------------------------------------------

# Publieke URL van de website (zonder slash aan het einde)
NEXT_PUBLIC_SITE_URL=https://www.dalas.nl

# --- Contact (header, footer, contactpagina + LocalBusiness schema) ---
NEXT_PUBLIC_PHONE=
# WhatsApp-nummer internationaal, alleen cijfers, bv. 31612345678.
# Leeg laten = het nummer uit src/lib/site.ts (31612739993). Alleen invullen om dat te overschrijven.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=

# --- Locatie (Local SEO). Laat leeg zolang de gegevens niet bekend zijn. ---
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_COUNTRY=NL
NEXT_PUBLIC_MAPS_URL=
# Formaat: "ma-vr 10:00-18:00; za 10:00-17:00"
NEXT_PUBLIC_OPENING_HOURS=

# --- Social / Google Business Profile ---
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# --- Analytics & Ads (gebruik óf GTM óf GA4 direct; GTM heeft de voorkeur) ---
# Buiten productie wordt er geen tag geladen: eigen testverkeer hoort niet
# in de cijfers waarop de advertenties bieden.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# Staat standaard op AW-18470230470 in site.ts; alleen invullen om te overschrijven
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversieactie "Leadformulier indienen"; staat standaard in site.ts
NEXT_PUBLIC_ADS_CONVERSION_LEAD=
# Alleen invullen als je per formulier een eigen conversieactie in Google Ads
# aanmaakt. Leeg betekent: meetellen op de lead-conversie hierboven.
NEXT_PUBLIC_ADS_CONVERSION_APPOINTMENT=
NEXT_PUBLIC_ADS_CONVERSION_PRICE_REQUEST=
NEXT_PUBLIC_ADS_CONVERSION_CONTACT=

# --- Formulieren (server-side, nooit NEXT_PUBLIC_) ---
# Waar aanvragen binnenkomen. Verplicht, anders worden formulieren in
# productie geweigerd in plaats van stil te mislukken.
FORM_TO_EMAIL=
# Afzender. Laat leeg om SMTP_USER te gebruiken.
FORM_FROM_EMAIL="Dalas Website <website@dalas-boutique.nl>"

# SMTP (de gekozen route). Alle drie invullen, anders wordt SMTP overgeslagen.
SMTP_HOST=
# 587 = STARTTLS (standaard), 465 = directe TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optioneel "true"/"false"; standaard afgeleid uit de poort
SMTP_SECURE=

# Alternatief voor SMTP: Resend REST API. Alleen invullen als je geen SMTP gebruikt.
RESEND_API_KEY=
